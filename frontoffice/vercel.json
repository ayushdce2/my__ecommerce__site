


{
  "rewrites": [
    {
      "source": "/user",
      "destination": "https://my-ecommerce-backoffice.vercel.app/user"
    },
    {
      "source": "/user/:path*",
      "destination": "https://my-ecommerce-backoffice.vercel.app/user/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
